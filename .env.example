PORT=8765
HOST=127.0.0.1
VOICE_MODE=live
VOICE_ENABLE_DEMO=false
TIME_ZONE=Asia/Shanghai
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
QWEN_MODEL=qwen-audio-3.0-realtime-flash
QWEN_VOICE=longanqian
QWEN_VAD_TYPE=smart_turn
DEEPSEEK_MODEL=deepseek-v4-flash
# 0 或不配置：不限制 Agent 执行轮数；正整数：显式设置轮数上限
AGENT_MAX_TURNS=0
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Python 3.12+; replace with your selected environment's executable if needed.
PYTHON_EXECUTABLE=python
# Optional, relative to the host project working directory.
VOICE_PROJECT_MODULE=
DATA_DIR=.xiaoyun/data
ALLOWED_ORIGINS=
